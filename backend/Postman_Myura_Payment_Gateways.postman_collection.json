							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"newuser@example.com\",\n    \"password\": \"your_secure_password\",\n    \"password2\": \"your_secure_password\",\n    \"first_name\": \"John\",\n    \"last_name\": \"Doe\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/register/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"register",
								""
							]
						},
						"description": "Register a new user account."
					},
					"response": []
				},
				{
					"name": "Get User Profile",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{auth_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/auth/user/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"user",
								""
							]
						},
						"description": "Get current user profile information. Requires authentication."
					},
					"response": []
				}
			],
			"description": "Authentication endpoints for login and user management"
		},
		{
			"name": "PhonePe Payment",
			"item": [
				{
					"name": "Create PhonePe Payment",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.collectionVariables.set(\"phonepe_payment_url\", response.payment_url);",
									"    pm.collectionVariables.set(\"phonepe_transaction_id\", response.transaction_id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{auth_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"amount\": {{test_amount_paise}},\n    \"order_id\": {{test_order_id}}\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/payments/phonepe/create/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"payments",
								"phonepe",
								"create",
								""
							]
						},
						"description": "Create a PhonePe payment request. Amount should be in paise (multiply rupees by 100)."
					},
					"response": []
				},
				{
					"name": "Verify PhonePe Payment",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{auth_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"transaction_id\": \"{{phonepe_transaction_id}}\",\n    \"order_id\": {{test_order_id}}\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/payments/phonepe/verify/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"payments",
								"phonepe",
								"verify",
								""
							]
						},
						"description": "Verify PhonePe payment status from frontend. Use transaction_id from create payment response."
					},
					"response": []
				},
				{
					"name": "PhonePe Callback (Webhook)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"description": "Optional - for callback verification"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"type\": \"PAYMENT_PAGE_INITIATED\",\n    \"data\": {\n        \"merchantId\": \"{{phonepe_merchant_id}}\",\n        \"merchantTransactionId\": \"{{phonepe_transaction_id}}\",\n        \"merchantOrderId\": \"{{phonepe_transaction_id}}\",\n        \"transactionId\": \"T2301011234567890\",\n        \"state\": \"COMPLETED\",\n        \"responseCode\": \"PAYMENT_SUCCESS\"\n    }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/payments/phonepe/callback/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"payments",
								"phonepe",
								"callback",
								""
							]
						},
						"description": "PhonePe webhook callback endpoint. This is called by PhonePe after payment. Usually tested manually or with PhonePe webhook tester."
					},
					"response": []
				}
			],
			"description": "PhonePe payment gateway endpoints"
		},
