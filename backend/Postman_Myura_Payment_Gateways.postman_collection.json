	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.access) {",
									"        pm.collectionVariables.set(\"auth_token\", response.access);",
									"        pm.environment.set(\"auth_token\", response.access);",
									"    } else if (response.token) {",
									"        pm.collectionVariables.set(\"auth_token\", response.token);",
									"        pm.environment.set(\"auth_token\", response.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"your_email@example.com\",\n    \"password\": \"your_password\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/login/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login",
								""
							]
						},
						"description": "Login to get JWT access token. The token will be automatically saved to auth_token variable."
					},
					"response": []
				},
				{
					"name": "Register",
