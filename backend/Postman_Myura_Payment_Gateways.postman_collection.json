{
	"info": {
		"_postman_id": "payment-gateways-collection",
		"name": "Myura Wellness - Payment Gateways",
		"description": "Complete collection of payment gateway APIs for Myura Wellness platform",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
